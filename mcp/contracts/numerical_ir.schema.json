{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aes.local/contracts/numerical_ir.schema.json",
  "title": "AES Numerical Intermediate Representation",
  "type": "object",
  "required": ["schema_version", "equation_family", "spatial_dimension", "unknown", "terms", "boundary_conditions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "equation_family": {"enum": ["stationary_diffusion", "transient_diffusion"]},
    "spatial_dimension": {"type": "integer", "minimum": 1, "maximum": 3},
    "unknown": {"type": "string"},
    "terms": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "boundary_conditions": {"type": "array", "items": {"type": "object"}},
    "time": {"type": ["object", "null"]}
  },
  "additionalProperties": false
}
