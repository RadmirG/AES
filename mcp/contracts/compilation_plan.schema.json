{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aes.local/contracts/compilation_plan.schema.json",
  "title": "AES Compilation Plan",
  "type": "object",
  "required": ["schema_version", "status", "backend", "compiler_version", "expected_artifacts", "capability_errors"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["ready", "unsupported"]},
    "backend": {"const": "dolfinx"},
    "compiler_version": {"type": "string"},
    "numerical_ir": {"oneOf": [{"$ref": "numerical_ir.schema.json"}, {"type": "null"}]},
    "mesh_uri": {"type": ["string", "null"]},
    "expected_artifacts": {"type": "array", "items": {"type": "string"}},
    "capability_errors": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
